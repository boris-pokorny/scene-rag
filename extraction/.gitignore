# pdm (PEP 582 mode) / Python tooling
__pypackages__/
__pycache__/
.pdm-python
.pdm-build/
.venv/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.py[cod]
*.log

# Media put under data/ for local runs is never committed
data/*
!data/media/
data/media/*
!data/media/.gitkeep
*.mp4
*.m4v
*.mkv
*.webm
*.mov
*.avi

# Local settings; copy from .env.example. Never committed.
.env

# Test artifacts
.coverage
.coverage.*
htmlcov/
