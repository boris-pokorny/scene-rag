# Settings for local runs; loaded by `pdm run`. Real environment variables win.
# Settings say where and how fast the step runs; hyperparameters live in
# src/scene_rag/extraction/<step>/config.py. README.md describes each variable.

# MongoDB holding the Asset Registry (required).
SCENE_RAG_EXTRACTION_REGISTRY_URI=mongodb://localhost:27017
# Database for the registry collection (required).
SCENE_RAG_EXTRACTION_REGISTRY_DATABASE=scene_rag_extraction
# Directory the filesystem connector lists; must exist (required).
SCENE_RAG_EXTRACTION_SOURCE_ROOT=data/media
# Identifier stamped on every source reference from this directory (required).
SCENE_RAG_EXTRACTION_SOURCE_ID=local
# Comma-separated entitlements granted to every file, at least one (required).
SCENE_RAG_EXTRACTION_SOURCE_ENTITLEMENTS=public
# Seconds between worker passes; only the loop needs it, `--once` ignores it.
SCENE_RAG_EXTRACTION_POLL_INTERVAL_SECONDS=30

# MongoDB holding the Scene Store (required by segmentation; the same server locally).
SCENE_RAG_EXTRACTION_SCENE_STORE_URI=mongodb://localhost:27017
# Database for the scene set collection (required by segmentation).
SCENE_RAG_EXTRACTION_SCENE_STORE_DATABASE=scene_rag_extraction
# Directory the filesystem Derivative Store files keyframes and audio clips under; created on
# first use (required by segmentation).
SCENE_RAG_EXTRACTION_DERIVATIVE_ROOT=data/derivatives
# ffmpeg executable name or path; defaults to the one on PATH.
# SCENE_RAG_EXTRACTION_FFMPEG_BINARY=ffmpeg
# Asset versions segmented at once within a pass; 1 (one after another) by default. One version
# already keeps about four cores busy decoding, so about cores / 4 is worthwhile.
# SCENE_RAG_EXTRACTION_SEGMENTATION_WORKERS=1
# ffmpeg processes slicing one version's audio clips at once; 1 by default, 4 is a measured
# sweet spot. Up to workers x clip workers ffmpeg processes run at once.
# SCENE_RAG_EXTRACTION_AUDIO_CLIP_WORKERS=4
