# Settings for local runs; loaded by `pdm run`. Real environment variables win.
# Settings say where the service runs; its hyperparameters (cut-offs, gate tolerances) live
# in src/scene_rag/evaluation/config.py. README.md describes each variable.

# Base URL of the retrieval service's query-api, the only thing evaluated (required by run).
SCENE_RAG_EVALUATION_QUERY_API_URL=http://127.0.0.1:8081
# Longest wait for one query-api answer in seconds; 300 by default (answers are generated).
# SCENE_RAG_EVALUATION_QUERY_API_TIMEOUT_SECONDS=300
# Directory of the Eval Store: runs/ and verdicts/ beneath it (required).
SCENE_RAG_EVALUATION_EVAL_STORE_ROOT=data/eval-store
