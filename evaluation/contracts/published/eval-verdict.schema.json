{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scene-rag.example/evaluation/published/eval-verdict.schema.json",
  "title": "EvalVerdict",
  "description": "The promotion gate's decision on a candidate eval run, written to the Eval Store as verdicts/<run_id>.json. A release step promotes a candidate only on 'passed' and records run_id, dataset and served in its release manifest. Passed means: no failed query-api call, every zero metric zero, and no primary metric below the baseline's by more than the tolerance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "baseline_run_id", "dataset", "served",
    "verdict", "checks", "gate", "decided_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "description": "The candidate run.", "$ref": "#/$defs/run_id" },
    "baseline_run_id": {
      "description": "The run it was held against; null for a first release.",
      "oneOf": [{ "$ref": "#/$defs/run_id" }, { "type": "null" }]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "served": {
      "description": "What the candidate run measured, as query-api reported it; null when no call succeeded.",
      "oneOf": [
        {
          "type": "object",
          "required": ["query_config", "embedding_fingerprint", "chunking_fingerprint", "collection"],
          "properties": {
            "query_config": { "type": "string" },
            "embedding_fingerprint": { "type": "string" },
            "chunking_fingerprint": { "type": ["string", "null"] },
            "collection": { "type": "string" }
          }
        },
        { "type": "null" }
      ]
    },
    "verdict": { "enum": ["passed", "failed"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "candidate", "baseline", "tolerance", "passed"],
        "properties": {
          "name": { "description": "'errors' or a metric key.", "type": "string", "minLength": 1 },
          "candidate": { "type": ["number", "null"] },
          "baseline": { "type": ["number", "null"] },
          "tolerance": { "type": ["number", "null"], "minimum": 0 },
          "passed": { "type": "boolean" }
        }
      }
    },
    "gate": {
      "description": "The rule's parameters.",
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_metrics", "tolerance", "zero_metrics"],
      "properties": {
        "primary_metrics": { "type": "array", "items": { "type": "string" } },
        "tolerance": { "type": "number", "minimum": 0 },
        "zero_metrics": { "type": "array", "items": { "type": "string" } }
      }
    },
    "decided_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "run_id": { "type": "string", "pattern": "^run-[0-9a-f]{12}$" }
  }
}
