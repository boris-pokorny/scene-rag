# Settings for local runs; loaded by `pdm run`. Real environment variables win.
# Settings say where and how fast the step runs; hyperparameters live in
# src/scene_rag/retrieval/<step>/config.py. README.md describes each variable.

# Base URL of the extraction service's scene-api, the only source of scene records (required).
SCENE_RAG_RETRIEVAL_SCENE_API_URL=http://127.0.0.1:8080
# Longest wait for one scene-api answer in seconds; 30 by default.
# SCENE_RAG_RETRIEVAL_SCENE_API_TIMEOUT_SECONDS=30
# MongoDB holding the Chunk Store (required).
SCENE_RAG_RETRIEVAL_CHUNK_STORE_URI=mongodb://localhost:27017
# Database for the chunk collections (required).
SCENE_RAG_RETRIEVAL_CHUNK_STORE_DATABASE=scene_rag_retrieval
# Seconds between worker passes; only the loop needs it, `--once` ignores it.
SCENE_RAG_RETRIEVAL_POLL_INTERVAL_SECONDS=30
# Scene sets chunked at once within a pass; 1 (one after another) by default.
# SCENE_RAG_RETRIEVAL_CHUNKING_WORKERS=1

# --- embedding step (the Chunk Store variables above serve it too) ---
# Base URL of the Qdrant server holding the Search Index (required).
SCENE_RAG_RETRIEVAL_SEARCH_INDEX_URL=http://localhost:6333
# Longest wait for one Search Index answer in seconds; 30 by default.
# SCENE_RAG_RETRIEVAL_SEARCH_INDEX_TIMEOUT_SECONDS=30
# Ollama server serving the embedding model; http://localhost:11434 by default.
# SCENE_RAG_RETRIEVAL_OLLAMA_URL=http://localhost:11434
# Longest wait for one embedding answer in seconds; 120 by default.
# SCENE_RAG_RETRIEVAL_OLLAMA_TIMEOUT_SECONDS=120
# Texts embedded per request to the model; 32 by default.
# SCENE_RAG_RETRIEVAL_EMBEDDING_BATCH_SIZE=32
# Chunk sets embedded at once within a pass; 1 (one after another) by default.
# SCENE_RAG_RETRIEVAL_EMBEDDING_WORKERS=1

# --- query-api role (the Chunk Store, Search Index, Ollama and scene-api variables above serve it too) ---
# Interface and port the server listens on; 127.0.0.1 and 8081 by default.
# SCENE_RAG_RETRIEVAL_QUERY_API_HOST=127.0.0.1
# SCENE_RAG_RETRIEVAL_QUERY_API_PORT=8081
# Host header values served, comma-separated, without the port; any other is refused with 400,
# against DNS rebinding. * serves every host, for a gateway that checks it. 127.0.0.1,localhost
# by default.
# SCENE_RAG_RETRIEVAL_QUERY_API_ALLOWED_HOSTS=127.0.0.1,localhost
# Longest wait for one generated answer in seconds; 300 by default.
# SCENE_RAG_RETRIEVAL_QUERY_API_GENERATOR_TIMEOUT_SECONDS=300
