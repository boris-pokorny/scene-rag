# Settings for local runs; loaded by `pdm run`. Real environment variables win.
# Settings say where and how fast the step runs; hyperparameters live in
# src/scene_rag/retrieval/<step>/config.py. README.md describes each variable.

# Base URL of the extraction service's scene-api, the only source of scene records (required).
SCENE_RAG_RETRIEVAL_SCENE_API_URL=http://127.0.0.1:8080
# Longest wait for one scene-api answer in seconds; 30 by default.
# SCENE_RAG_RETRIEVAL_SCENE_API_TIMEOUT_SECONDS=30
# MongoDB holding the Chunk Store (required).
SCENE_RAG_RETRIEVAL_CHUNK_STORE_URI=mongodb://localhost:27017
# Database for the chunk collections (required).
SCENE_RAG_RETRIEVAL_CHUNK_STORE_DATABASE=scene_rag_retrieval
# Seconds between worker passes; only the loop needs it, `--once` ignores it.
SCENE_RAG_RETRIEVAL_POLL_INTERVAL_SECONDS=30
# Scene sets chunked at once within a pass; 1 (one after another) by default.
# SCENE_RAG_RETRIEVAL_CHUNKING_WORKERS=1
