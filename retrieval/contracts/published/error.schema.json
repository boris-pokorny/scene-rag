{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scene-rag.example/retrieval/published/error.schema.json",
  "title": "Error",
  "description": "The body of every non-2xx answer of the query-api. The MCP adapter reports the same codes as the text of a failed tool or resource call: '<code>: <message>'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_parameter",
            "not_found",
            "method_not_allowed",
            "index_unavailable",
            "model_unavailable",
            "scene_api_unavailable",
            "internal_error"
          ]
        },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
