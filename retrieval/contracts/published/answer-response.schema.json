{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scene-rag.example/retrieval/published/answer-response.schema.json",
  "title": "AnswerResponse",
  "description": "The answer to POST /answer and to the answer tool. `[n]` in the answer cites sources[n-1]; citations lists the numbers that name a source in order of first mention, invalid_citations those that do not. A refusal carries the configured refusal text, no citations and no usage; its sources are the spans judged too weak.",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "refused", "citations", "invalid_citations", "sources", "usage", "served"],
  "properties": {
    "answer": { "type": "string", "minLength": 1 },
    "refused": { "type": "boolean" },
    "citations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "invalid_citations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 0 }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "https://scene-rag.example/retrieval/published/source.schema.json" }
    },
    "usage": {
      "description": "Tokens the generation consumed, when the model reports them; null for a refusal.",
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_tokens", "completion_tokens"],
      "properties": {
        "prompt_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "completion_tokens": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "served": { "$ref": "https://scene-rag.example/retrieval/published/served.schema.json" }
  }
}
