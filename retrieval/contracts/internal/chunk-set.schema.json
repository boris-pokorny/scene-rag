{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scene-rag.example/retrieval/internal/chunk-set.schema.json",
  "title": "ChunkSet",
  "description": "One document of the Chunk Store (collection chunk_sets): the completion marker of one scene set chunked under one chunking fingerprint, written after its chunks. Pending work is derived from it: a scene set listed by scene-api with no chunk set under the current fingerprint is pending. Written only by the chunking step. A chunk_count of zero is a valid outcome: no scene of the set had text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "_id", "schema_version", "scene_set_version", "asset_version", "segmentation_fingerprint",
    "pins", "chunk_count", "created_at", "lineage"
  ],
  "properties": {
    "_id": {
      "description": "Data version of the chunk set: hash(scene set version + fingerprint).",
      "$ref": "#/$defs/version"
    },
    "schema_version": { "const": 1 },
    "scene_set_version": { "$ref": "#/$defs/version" },
    "asset_version": { "$ref": "#/$defs/version" },
    "segmentation_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "pins": {
      "description": "Enrichment pins '<enricher>:<fingerprint>' the scene records were fetched under, one per required enricher.",
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*:[0-9a-f]{12}$" },
      "uniqueItems": true
    },
    "chunk_count": { "type": "integer", "minimum": 0 },
    "created_at": { "$ref": "#/$defs/datetime" },
    "lineage": { "$ref": "#/$defs/lineage" }
  },
  "$defs": {
    "version": {
      "description": "Content hash: '<algorithm>:<hex digest>'.",
      "type": "string",
      "pattern": "^[a-z0-9_]+:[0-9a-f]+$"
    },
    "fingerprint": {
      "description": "Step fingerprint: twelve hex digits.",
      "type": "string",
      "pattern": "^[0-9a-f]{12}$"
    },
    "datetime": {
      "description": "UTC timestamp. Stored as a BSON date; rendered as RFC 3339 in JSON samples.",
      "type": "string",
      "format": "date-time"
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "fingerprint", "inputs", "version", "image"],
      "properties": {
        "step": { "const": "chunking" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "inputs": {
          "description": "Data versions read: every scene record of the set, in scene order.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^scene-record:[a-z0-9_]+:[0-9a-f]+$" }
        },
        "version": { "$ref": "#/$defs/version" },
        "image": { "type": ["string", "null"] }
      }
    }
  }
}
